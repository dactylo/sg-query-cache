from asyncio import StreamReader, StreamWriter
from collections.abc import Callable, Iterable
from weakref import WeakSet

class AbstractConnection:
    _reader: StreamReader | None
    _writer: StreamWriter | None
    is_connected: bool
    db: int
    socket_timeout: float | None

    async def _send_packed_command(self, command: Iterable[bytes]) -> None: ...
    async def can_read_destructive(self) -> bool: ...
    async def check_health(self) -> None: ...
    async def connect(self) -> None: ...
    async def disconnect(self, nowait: bool = False) -> None: ...
    async def on_connect(self) -> None: ...
    async def read_response(self) -> object: ...
    def register_connect_callback(
        self, callback: Callable[[AbstractConnection], None]
    ) -> None: ...
    async def send_command(self, *args: object, **kwargs: object) -> None: ...
    async def send_packed_command(
        self, command: bytes | str | Iterable[bytes], check_health: bool = True
    ) -> None: ...

class Connection(AbstractConnection): ...
class SSLConnection(Connection): ...

class ConnectionPool:
    _available_connections: list[AbstractConnection]
    _in_use_connections: set[AbstractConnection] | WeakSet[AbstractConnection]
    connection_class: type[AbstractConnection]

    def __init__(
        self,
        connection_class: type[AbstractConnection] = ...,
        max_connections: int | None = None,
        **connection_kwargs: object,
    ) -> None: ...
    async def disconnect(self, inuse_connections: bool = True) -> None: ...
    async def ensure_connection(self, connection: AbstractConnection) -> None: ...
    def make_connection(self) -> AbstractConnection: ...
    async def release(self, connection: AbstractConnection) -> None: ...
